<!-- category-form.wxml -->
<!-- 分类表单页面 -->
<!-- Requirements: 2.1, 2.2, 3.1, 3.2 -->
<view class="container">
  <!-- 导航栏 -->
  <navigation-bar title="{{mode === 'add' ? '新增分类' : '编辑分类'}}" showBack="{{true}}" bindback="navigateBack" />
  
  <!-- 内容区域 -->
  <view class="content-container" style="padding-top: {{contentPaddingTop}}px;">
    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 表单区域 -->
    <view class="form-container" wx:if="{{!loading}}">
      <!-- 分类名称 -->
      <view class="form-group">
        <view class="form-label required">分类名称</view>
        <input 
          class="form-input {{errors.name ? 'input-error' : ''}}"
          placeholder="请输入分类名称"
          value="{{formData.name}}"
          bindinput="onInputChange"
          data-field="name"
          maxlength="20"
        />
        <view class="error-text" wx:if="{{errors.name}}">{{errors.name}}</view>
      </view>

      <!-- 分类描述 -->
      <view class="form-group">
        <view class="form-label">分类描述</view>
        <textarea 
          class="form-textarea"
          placeholder="请输入分类描述（选填）"
          value="{{formData.description}}"
          bindinput="onInputChange"
          data-field="description"
          maxlength="200"
        />
        <view class="char-count">{{formData.description.length || 0}}/200</view>
      </view>

      <!-- 分类图标 -->
      <view class="form-group">
        <view class="form-label">分类图标</view>
        <view class="image-upload-area">
          <view class="image-preview" wx:if="{{formData.icon}}" bindtap="chooseIcon">
            <image src="{{formData.icon}}" mode="aspectFit" />
            <view class="image-remove" catchtap="removeIcon">×</view>
          </view>
          <view class="image-placeholder" wx:else bindtap="chooseIcon">
            <text class="placeholder-icon">+</text>
            <text class="placeholder-text">上传图标</text>
          </view>
        </view>
      </view>

      <!-- 分类图片 -->
      <view class="form-group">
        <view class="form-label">分类图片</view>
        <view class="image-upload-area">
          <view class="image-preview large" wx:if="{{formData.image}}" bindtap="chooseImage">
            <image src="{{formData.image}}" mode="aspectFit" />
            <view class="image-remove" catchtap="removeImage">×</view>
          </view>
          <view class="image-placeholder large" wx:else bindtap="chooseImage">
            <text class="placeholder-icon">+</text>
            <text class="placeholder-text">上传图片</text>
          </view>
        </view>
      </view>

      <!-- 排序权重 -->
      <view class="form-group">
        <view class="form-label">排序权重</view>
        <input 
          class="form-input"
          type="number"
          placeholder="数字越小越靠前，默认999"
          value="{{formData.order}}"
          bindinput="onInputChange"
          data-field="order"
        />
        <view class="form-hint">数字越小，分类排序越靠前</view>
      </view>

      <!-- 状态 -->
      <view class="form-group">
        <view class="form-label">状态</view>
        <view class="status-switch">
          <switch 
            checked="{{formData.status === 1}}" 
            bindchange="onStatusChange"
            color="#8B5A2B"
          />
          <text class="status-text">{{formData.status === 1 ? '启用' : '禁用'}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="form-actions">
        <button class="btn-cancel" bindtap="navigateBack">取消</button>
        <button class="btn-submit" bindtap="submitForm" disabled="{{submitting}}">
          {{submitting ? '提交中...' : (mode === 'add' ? '新增' : '保存')}}
        </button>
      </view>
    </view>
  </view>
</view>