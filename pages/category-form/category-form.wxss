/* category-form.wxss */
/* 分类表单页面样式 */

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #F5F5DC;
  box-sizing: border-box;
}

.content-container {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  min-height: calc(100vh - 40rpx);
}

/* 加载中样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 表单容器 */
.form-container {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
}

/* 表单组 */
.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-label.required::before {
  content: '*';
  color: #F44336;
  margin-right: 8rpx;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input.input-error {
  border-color: #F44336;
  background-color: #ffebee;
}

/* 文本域样式 */
.form-textarea {
  width: 100%;
  height: 200rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 错误提示 */
.error-text {
  color: #F44336;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 表单提示 */
.form-hint {
  color: #999;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* 图片上传区域 */
.image-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  overflow: hidden;
  position: relative;
  background-color: #f5f5f5;
}

.image-preview.large {
  width: 240rpx;
  height: 160rpx;
}

.image-preview image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 8rpx;
}

.image-placeholder {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ccc;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafafa;
}

.image-placeholder.large {
  width: 240rpx;
  height: 160rpx;
}

.placeholder-icon {
  font-size: 48rpx;
  color: #ccc;
  margin-bottom: 8rpx;
}

.placeholder-text {
  font-size: 24rpx;
  color: #999;
}

/* 状态开关 */
.status-switch {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.status-text {
  font-size: 28rpx;
  color: #666;
}

/* 操作按钮 */
.form-actions {
  display: flex;
  gap: 30rpx;
  margin-top: 50rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 30rpx;
  border-radius: 8rpx;
}

.btn-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #8B5A2B;
  color: #fff;
  font-size: 30rpx;
  border-radius: 8rpx;
}

.btn-submit[disabled] {
  background-color: #ccc;
  color: #999;
}