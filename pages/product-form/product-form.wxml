<!-- product-form.wxml -->
<!-- 产品表单页面 -->
<!-- Requirements: 6.1, 6.2, 6.3, 7.1, 7.2, 7.3 -->
<view class="container">
  <!-- 导航栏 -->
  <navigation-bar title="{{mode === 'add' ? '新增产品' : '编辑产品'}}" showBack="{{true}}" bindback="navigateBack" />
  
  <!-- 内容区域 -->
  <scroll-view class="content-container" style="padding-top: {{contentPaddingTop}}px;" scroll-y="true">
    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 表单区域 -->
    <view class="form-container" wx:if="{{!loading}}">
      <!-- 基本信息 -->
      <view class="form-section">
        <view class="section-title">基本信息</view>
        
        <!-- 产品名称 -->
        <view class="form-group">
          <view class="form-label required">产品名称</view>
          <input 
            class="form-input {{errors.name ? 'input-error' : ''}}"
            placeholder="请输入产品名称"
            value="{{formData.name}}"
            bindinput="onInputChange"
            data-field="name"
            maxlength="50"
          />
          <view class="error-text" wx:if="{{errors.name}}">{{errors.name}}</view>
        </view>

        <!-- 产品分类 - Requirements 6.2 -->
        <view class="form-group">
          <view class="form-label required">产品分类</view>
          <picker 
            mode="selector" 
            range="{{categories}}" 
            range-key="name"
            value="{{selectedCategoryIndex}}"
            bindchange="onCategoryChange"
          >
            <view class="form-picker {{errors.categoryId ? 'input-error' : ''}}">
              <text>{{categories[selectedCategoryIndex].name || '请选择分类'}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
          <view class="error-text" wx:if="{{errors.categoryId}}">{{errors.categoryId}}</view>
        </view>

        <!-- 产品描述 -->
        <view class="form-group">
          <view class="form-label">产品描述</view>
          <textarea 
            class="form-textarea"
            placeholder="请输入产品描述（选填）"
            value="{{formData.description}}"
            bindinput="onInputChange"
            data-field="description"
            maxlength="500"
          />
          <view class="char-count">{{formData.description.length || 0}}/500</view>
        </view>
      </view>

      <!-- 价格信息 -->
      <view class="form-section">
        <view class="section-title">价格信息</view>
        
        <!-- 销售价格 -->
        <view class="form-group">
          <view class="form-label">销售价格</view>
          <input 
            class="form-input {{errors.price ? 'input-error' : ''}}"
            placeholder="输入数字或'联系销售'"
            value="{{formData.price}}"
            bindinput="onInputChange"
            data-field="price"
          />
          <view class="form-hint">输入数字表示价格，输入"联系销售"表示需要咨询</view>
          <view class="error-text" wx:if="{{errors.price}}">{{errors.price}}</view>
        </view>

        <!-- 原价 -->
        <view class="form-group">
          <view class="form-label">原价</view>
          <input 
            class="form-input"
            type="digit"
            placeholder="请输入原价（选填）"
            value="{{formData.originalPrice}}"
            bindinput="onInputChange"
            data-field="originalPrice"
          />
        </view>
      </view>

      <!-- 产品图片 - Requirements 6.3, 7.3 -->
      <view class="form-section">
        <view class="section-title">产品图片</view>
        
        <!-- 主图 -->
        <view class="form-group">
          <view class="form-label">主图（最多5张）</view>
          <view class="image-upload-area">
            <view 
              class="image-preview" 
              wx:for="{{formData.imageUrls}}" 
              wx:key="index"
            >
              <image src="{{item}}" mode="aspectFill" />
              <view class="image-remove" catchtap="removeMainImage" data-index="{{index}}">×</view>
            </view>
            <view 
              class="image-placeholder" 
              wx:if="{{formData.imageUrls.length < 5}}"
              bindtap="chooseMainImages"
            >
              <text class="placeholder-icon">+</text>
              <text class="placeholder-text">上传主图</text>
            </view>
          </view>
        </view>

        <!-- 详情图 -->
        <view class="form-group">
          <view class="form-label">详情图（最多10张）</view>
          <view class="image-upload-area">
            <view 
              class="image-preview" 
              wx:for="{{formData.images}}" 
              wx:key="index"
            >
              <image src="{{item}}" mode="aspectFill" />
              <view class="image-remove" catchtap="removeDetailImage" data-index="{{index}}">×</view>
            </view>
            <view 
              class="image-placeholder" 
              wx:if="{{formData.images.length < 10}}"
              bindtap="chooseDetailImages"
            >
              <text class="placeholder-icon">+</text>
              <text class="placeholder-text">上传详情图</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 产品特点 -->
      <view class="form-section">
        <view class="section-title">产品特点</view>
        
        <!-- 已添加的特点 -->
        <view class="list-items" wx:if="{{formData.features.length > 0}}">
          <view class="list-item" wx:for="{{formData.features}}" wx:key="index">
            <view class="item-content">
              <text class="item-title">{{item.title}}</text>
              <text class="item-value">{{item.content}}</text>
            </view>
            <view class="item-remove" bindtap="removeFeature" data-index="{{index}}">×</view>
          </view>
        </view>

        <!-- 添加新特点 -->
        <view class="add-item-form">
          <input 
            class="add-input"
            placeholder="特点标题"
            value="{{newFeature.title}}"
            bindinput="onNewFeatureInput"
            data-field="title"
          />
          <input 
            class="add-input"
            placeholder="特点内容"
            value="{{newFeature.content}}"
            bindinput="onNewFeatureInput"
            data-field="content"
          />
          <button class="btn-add-item" bindtap="addFeature">添加</button>
        </view>
      </view>

      <!-- 产品参数 -->
      <view class="form-section">
        <view class="section-title">产品参数</view>
        
        <!-- 已添加的参数 -->
        <view class="list-items" wx:if="{{formData.params.length > 0}}">
          <view class="list-item" wx:for="{{formData.params}}" wx:key="index">
            <view class="item-content">
              <text class="item-title">{{item.name}}</text>
              <text class="item-value">{{item.value}}</text>
            </view>
            <view class="item-remove" bindtap="removeParam" data-index="{{index}}">×</view>
          </view>
        </view>

        <!-- 添加新参数 -->
        <view class="add-item-form">
          <input 
            class="add-input"
            placeholder="参数名称"
            value="{{newParam.name}}"
            bindinput="onNewParamInput"
            data-field="name"
          />
          <input 
            class="add-input"
            placeholder="参数值"
            value="{{newParam.value}}"
            bindinput="onNewParamInput"
            data-field="value"
          />
          <button class="btn-add-item" bindtap="addParam">添加</button>
        </view>
      </view>

      <!-- 其他设置 -->
      <view class="form-section">
        <view class="section-title">其他设置</view>
        
        <!-- 标签设置 -->
        <view class="form-group">
          <view class="form-label">产品标签</view>
          <view class="switch-group">
            <view class="switch-item">
              <text>热门</text>
              <switch 
                checked="{{formData.isHot}}" 
                bindchange="onSwitchChange"
                data-field="isHot"
                color="#F44336"
              />
            </view>
            <view class="switch-item">
              <text>新品</text>
              <switch 
                checked="{{formData.isNew}}" 
                bindchange="onSwitchChange"
                data-field="isNew"
                color="#2196F3"
              />
            </view>
            <view class="switch-item">
              <text>推荐</text>
              <switch 
                checked="{{formData.isRecommended}}" 
                bindchange="onSwitchChange"
                data-field="isRecommended"
                color="#FF9800"
              />
            </view>
          </view>
        </view>

        <!-- 排序权重 -->
        <view class="form-group">
          <view class="form-label">排序权重</view>
          <input 
            class="form-input"
            type="number"
            placeholder="数字越小越靠前，默认999"
            value="{{formData.order}}"
            bindinput="onInputChange"
            data-field="order"
          />
          <view class="form-hint">数字越小，产品排序越靠前</view>
        </view>

        <!-- 状态 -->
        <view class="form-group">
          <view class="form-label">上架状态</view>
          <view class="status-switch">
            <switch 
              checked="{{formData.status === 1}}" 
              bindchange="onStatusChange"
              color="#4CAF50"
            />
            <text class="status-text">{{formData.status === 1 ? '已上架' : '已下架'}}</text>
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="form-actions">
        <button class="btn-cancel" bindtap="navigateBack">取消</button>
        <button class="btn-submit" bindtap="submitForm" disabled="{{submitting}}">
          {{submitting ? '提交中...' : (mode === 'add' ? '新增' : '保存')}}
        </button>
      </view>
    </view>
  </scroll-view>
</view>
