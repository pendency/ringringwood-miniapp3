/* pages/fix-database-urls/fix-database-urls.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 30rpx;
  padding: 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.warning {
  background: #fff3cd;
  border: 2rpx solid #ffeaa7;
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 30rpx;
}

.warning-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #856404;
  margin-bottom: 15rpx;
}

.warning-content {
  font-size: 26rpx;
  color: #856404;
  line-height: 1.5;
}

.actions {
  margin-bottom: 30rpx;
}

.action-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.fix-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
  color: white;
}

.action-btn[disabled] {
  background: #ccc !important;
  color: #999 !important;
}

.results-section,
.logs-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #eee;
}

.clear-btn {
  background: #ff4757;
  color: white;
  border: none;
  border-radius: 20rpx;
  width: 100rpx;
  height: 50rpx;
  font-size: 24rpx;
  padding: 0;
}

.results-summary {
  display: flex;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.result-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.result-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.result-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.result-value.success {
  color: #2ed573;
}

.results-list,
.logs-list {
  max-height: 600rpx;
}

.result-product {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 20rpx;
  margin-bottom: 10rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.product-status {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
}

.product-status.fixed {
  background: #e6ffe6;
  color: #2ed573;
}

.product-status.unchanged {
  background: #e6f3ff;
  color: #3742fa;
}

.log-item {
  font-size: 24rpx;
  color: #666;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  word-break: break-all;
}

.log-item:last-child {
  border-bottom: none;
}

.footer {
  text-align: center;
  margin-top: 30rpx;
}

.back-btn {
  width: 200rpx;
  height: 70rpx;
  background: #ddd;
  color: #666;
  border-radius: 35rpx;
  font-size: 28rpx;
}




































