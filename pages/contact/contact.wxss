/* contact.wxss */
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #F5F5DC;
  color: #5D4037;
}

/* 页面整体容器 */
.container {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  background-color: #F5F5DC;
}

/* 侧边菜单 */
.side-menu {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
  overflow: hidden;
}

.side-menu.show {
  pointer-events: auto;
  opacity: 1;
}

.menu-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.menu-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 70%;
  height: 100%;
  background-color: #fff;
  transform: translateX(-100%);
  transition: transform 0.3s;
}

.side-menu.show .menu-content {
  transform: translateX(0);
}

.menu-header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1px solid #eee;
}

.menu-logo {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.menu-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #5D4037;
}

.menu-list {
  padding: 20rpx 0;
}

.menu-item {
  padding: 30rpx;
  font-size: 32rpx;
  color: #5D4037;
  border-bottom: 1px solid #f5f5f5;
}

/* 内容区域 - 为顶部导航腾出空间 */
.content-container {
  padding-top: 64px; /* 默认留出空间，实际会由JS动态计算 */
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 20rpx 30rpx;
  background-color: #F5F5DC;
}

/* 内容区块 */
.section {
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5D4037;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: #D4B08C;
  border-radius: 4rpx;
}

/* 联系方式 */
.contact-info {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.1);
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 20rpx;
  background-color: #F5F5DC;
  border-radius: 50%;
}

.contact-icon image {
  width: 50rpx;
  height: 50rpx;
}

.contact-icon .icon-text {
  font-size: 40rpx;
  line-height: 1;
}

.contact-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.contact-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #5D4037;
  margin-bottom: 8rpx;
}

.contact-value {
  font-size: 26rpx;
  color: #8B5A2B;
}

.contact-action {
  padding: 10rpx 30rpx;
  background-color: #D4B08C;
  color: #fff;
  font-size: 26rpx;
  border-radius: 30rpx;
}

/* 营业时间项（无操作按钮） */
.business-hours-item {
  cursor: default;
}

.business-hours-item .contact-detail {
  flex: 1;
}

/* 二维码 */
.qrcode-section {
  display: flex;
  justify-content: center;
  align-items: center;
}

.qrcode-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 20rpx;
}

.qrcode-text {
  font-size: 28rpx;
  color: #5D4037;
}
