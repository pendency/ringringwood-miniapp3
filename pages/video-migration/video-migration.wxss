/* pages/video-migration/video-migration.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding: 20rpx;
  background-color: white;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.header-actions {
  display: flex;
  gap: 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.tool-btn {
  background: linear-gradient(45deg, #007aff, #5ac8fa);
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.reset-btn {
  background-color: #8e8e93;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 10rpx 20rpx;
  font-size: 28rpx;
}

.steps {
  margin-bottom: 30rpx;
}

.step-card {
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  transition: opacity 0.3s;
}

.step-card.disabled {
  opacity: 0.5;
}

.step-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}

.step-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.step-status {
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #666;
}

.step-status.active {
  background-color: #007aff;
  color: white;
}

.step-content {
  font-size: 28rpx;
}

.step-desc {
  color: #666;
  line-height: 1.5;
  display: block;
  margin-bottom: 20rpx;
}

.step-result {
  background-color: #f8f8f8;
  border-radius: 8rpx;
  padding: 15rpx;
  margin-bottom: 20rpx;
}

.result-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.result-item:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
}

.value {
  font-weight: bold;
  color: #333;
}

.value.highlight {
  color: #ff9500;
}

.value.success {
  color: #34c759;
}

.value.error {
  color: #ff3b30;
}

.detail-btn {
  background-color: #007aff;
  color: white;
  border: none;
  border-radius: 6rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.action-btn {
  width: 100%;
  border: none;
  border-radius: 8rpx;
  padding: 15rpx;
  font-size: 30rpx;
  color: white;
}

.action-btn.primary {
  background-color: #007aff;
}

.action-btn.warning {
  background-color: #ff9500;
}

.action-btn.success {
  background-color: #34c759;
}

.action-btn[disabled] {
  background-color: #c7c7cc !important;
  color: #8e8e93 !important;
}

.completion {
  background-color: white;
  border-radius: 10rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.completion-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.completion-text {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #34c759;
  margin-bottom: 15rpx;
}

.completion-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.actions {
  text-align: center;
  padding: 20rpx;
}

.back-btn {
  background-color: #666;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 15rpx 40rpx;
  font-size: 30rpx;
}
