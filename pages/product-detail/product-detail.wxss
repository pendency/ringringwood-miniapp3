/* product-detail.wxss */
/* 页面整体容器 */
.page {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  background-color: #F5F5DC;
}

/* 内容滚动区域 */
.content-container {
  flex: 1;
  box-sizing: border-box;
  background-color: #F5F5DC;
  width: 100%;
  height: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 140rpx;
}

/* 内容包装器 - 用于页面滚动 */
.content-wrapper {
  width: 100%;
  min-height: 100vh;
  background-color: #F5F5DC;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.container {
  padding: 0 0 180rpx 0; /* 添加足够的底部内边距，确保内容不被底部按钮遮挡 */
  box-sizing: border-box;
}

/* 自定义轮播图 */
.product-swiper-container {
  width: 100%;
  height: 375px;
  background-color: #fff;
  position: relative;
  overflow: hidden;
}

.product-swiper {
  width: 100%;
  height: 375px;
}

.swiper-image {
  width: 100%;
  height: 375px;
  background-color: #fff;
}

.swiper-counter {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  z-index: 10;
}

/* 产品详情图展示 */
.detail-images-container {
  width: 100%;
  background-color: #fff;
}

.detail-image-item {
  width: 100%;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 0; /* 直角矩形 */
  overflow: visible; /* 允许内容完整显示 */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.detail-image-item:last-child {
  margin-bottom: 0;
}

.detail-image {
  width: 100%;
  height: auto; /* 自适应高度 */
  display: block;
  border-radius: 0; /* 直角矩形 */
  background-color: #f5f5f5;
}

.detail-image-caption {
  padding: 15rpx 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.detail-image-number {
  font-size: 24rpx;
  color: #666;
  font-weight: 400;
}

/* 产品视频展示 */
.detail-video-section {
  width: 100%;
  margin-top: 30rpx;
}

.detail-video-item {
  width: 100%;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 0; /* 直角矩形 */
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.detail-video-item:last-child {
  margin-bottom: 0;
}

.detail-video-title {
  padding: 20rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  background-color: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.video-container {
  width: 100%;
  position: relative;
  background-color: #000;
  /* 使用padding-bottom实现16:9宽高比 */
  padding-bottom: 56.25%; /* 16:9 = 9/16 = 0.5625 = 56.25% */
  height: 0;
}

.detail-video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: #000;
}

/* 视频错误提示 */
.video-error-tip {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  color: #666;
}

.error-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.error-text {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.error-detail {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
  text-align: center;
  line-height: 1.4;
}

.retry-btn {
  background-color: #D4B08C;
  color: #fff;
  border: none;
  border-radius: 6rpx;
  padding: 15rpx 30rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.retry-btn:active {
  background-color: #c19d7a;
}

.retry-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.error-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.detail-video-description {
  padding: 15rpx 20rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.detail-video-description text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 无详情图提示 */
.no-detail-images {
  width: 100%;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  color: #999;
  font-size: 28rpx;
  border-radius: 8rpx;
}

.no-image-tip {
  width: 100%;
  height: 375px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #999;
  font-size: 28rpx;
}

/* 调试信息 */
.debug-info {
  padding: 20rpx;
  background-color: #f8d7da;
  color: #721c24;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

/* 产品头部信息 */
.product-header {
  padding: 30rpx;
  background-color: #fff;
  margin-bottom: 20rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #5D4037;
  margin-bottom: 16rpx;
  display: block;
}

.product-brief {
  font-size: 28rpx;
  color: #8B5A2B;
  line-height: 1.5;
}

/* 分类标签 - 可点击跳转到分类页面 */
.category-tag {
  display: inline-flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background-color: #F5F5DC;
  border-radius: 20rpx;
  border: 1rpx solid #D4B08C;
}

.category-tag:active {
  background-color: #E8E8C8;
}

.category-tag-text {
  font-size: 24rpx;
  color: #8B5A2B;
}

.category-tag-arrow {
  font-size: 24rpx;
  color: #8B5A2B;
  margin-left: 8rpx;
}

/* 内容区块 */
.section {
  margin-bottom: 20rpx;
  background-color: #fff;
  padding: 30rpx;
}

/* 最后一个区块特殊处理 */
.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5D4037;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  background-color: #8B5A2B;
  border-radius: 4rpx;
}

/* 产品参数 */
.params-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.param-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.param-name {
  font-size: 28rpx;
  color: #666;
}

.param-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 无参数提示 */
.no-params-tip {
  text-align: center;
  padding: 40rpx 20rpx;
  color: #999;
  font-size: 28rpx;
}

/* 产品特点列表 - Requirements 3.5 */
.features-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  padding: 20rpx;
  background-color: #fafafa;
  border-radius: 8rpx;
  border-left: 4rpx solid #8B5A2B;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.feature-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 价格参数特殊样式 */
.price-value {
  color: #8B5A2B !important;
  font-weight: bold !important;
  font-size: 32rpx !important;
}

/* 价格容器 - Requirements 3.6 */
.price-container {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 原价样式 - Requirements 3.6 */
.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}



/* 相似推荐 */
.similar-section {
  margin-bottom: 0 !important;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom)) !important; /* 底部操作栏高度 + 安全区域 */
}

.similar-products {
  white-space: nowrap;
  padding: 20rpx 0 20rpx;
  margin-bottom: 0;
  height: auto;
  min-height: 300rpx; /* 适应1:1图片+2行文字 */
}

.similar-item {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  height: auto;
  background-color: #fff;
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
  vertical-align: top;
}

.similar-image-container {
  width: 200rpx;
  height: 200rpx; /* 1:1 比例 */
  overflow: hidden;
  position: relative;
}

.similar-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.similar-name-container {
  padding: 10rpx 12rpx;
  height: 72rpx; /* 2行文字高度 */
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
}

.similar-name {
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2; /* 限制2行 */
  -webkit-box-orient: vertical;
  white-space: normal; /* 允许换行 */
  width: 100%;
  text-align: center;
  line-height: 1.4;
}

/* 联系按钮 */
.contact-container {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  position: fixed; /* 使用fixed定位，确保不会影响内容布局 */
  bottom: 0;
  left: 0;
  right: 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  border-top: 1rpx solid #f0f0f0;
  height: 120rpx; /* 固定高度，与scroll-view计算的减去高度对应 */
  box-sizing: border-box;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); /* 适配全面屏底部安全区域 */
}

.contact-btn {
  flex: 1;
  margin: 0 10rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  background-color: #F5F5DC;
  color: #8B5A2B;
  border: none;
  padding: 0;
}

.contact-btn::after {
  border: none;
}

.btn-primary {
  background-color: #8B5A2B;
  color: #fff;
}

.favorite-active {
  background-color: #D4B08C;
  color: #fff;
}

/* 可点击的价格样式 */
.clickable-price {
  color: #8B5A2B !important;
  text-decoration: underline;
  cursor: pointer;
}

.clickable-price:hover {
  color: #6d4522 !important;
}

/* 微信二维码弹窗样式 */
.qrcode-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.qrcode-modal-content {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 0;
  max-width: 600rpx;
  width: 80%;
  max-height: 80vh;
  overflow: hidden;
}

.qrcode-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.qrcode-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #5D4037;
}

.qrcode-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
  cursor: pointer;
}

.qrcode-close:active {
  background-color: #f0f0f0;
  border-radius: 50%;
}

.qrcode-container {
  padding: 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 30rpx;
}

.qrcode-tips {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.qrcode-text-line {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  text-align: center;
  display: block;
}

.qrcode-text-highlight {
  font-size: 30rpx;
  color: #8B5A2B;
  font-weight: 500;
}

.qrcode-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

