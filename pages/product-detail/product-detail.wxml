<!--product-detail.wxml-->
<view class="page">
  <!-- 导航栏 -->
  <navigation-bar title="产品详情" bindback="onBack" showBack="{{true}}"></navigation-bar>
  
  <!-- 内容区域 -->
  <view class="content-wrapper" style="margin-top: {{contentPaddingTop}}px;">
    
    <!-- 产品图片轮播 -->
    <view class="product-swiper-container" style="width:100%;height:375px;background:#fff;position:relative;">
      <swiper wx:if="{{product.images && product.images.length > 0}}"
              style="width:100%;height:375px;"
              indicator-dots="{{true}}" 
              indicator-color="rgba(255,255,255,0.5)"
              indicator-active-color="#D4B08C"
              autoplay="{{false}}" 
              circular="{{true}}"
              current="{{currentImageIndex}}"
              bindchange="onSwiperChange"
              duration="300"
              easing-function="easeOutCubic">
        <swiper-item wx:for="{{product.images}}" wx:key="index">
          <image src="{{item}}"
                 mode="aspectFit"
                 style="width:100%;height:375px;background:#fff;"
                 bindtap="previewImage"
                 data-url="{{item}}"
                 data-index="{{index}}"></image>
        </swiper-item>
      </swiper>
      
      <view class="swiper-counter" wx:if="{{product.images && product.images.length > 1}}">
        {{currentImageIndex + 1}}/{{product.images.length}}
      </view>
      
      <view wx:if="{{!product.images || product.images.length === 0}}" 
            style="width:100%;height:375px;display:flex;align-items:center;justify-content:center;background:#fff;">
        <text style="color:#999;">暂无产品图片</text>
      </view>
    </view>

    <!-- 1. 产品名称及简介 -->
    <view class="product-header">
      <text class="product-name">{{product.name}}</text>
      <text class="product-brief">{{product.brief}}</text>
      <!-- 分类标签 - 点击可跳转到分类页面 -->
      <view class="category-tag" wx:if="{{product.categoryName || product.category}}" bindtap="onCategoryTap">
        <text class="category-tag-text">{{product.categoryName || product.category}}</text>
        <text class="category-tag-arrow">›</text>
      </view>
    </view>

    <!-- 2. 产品参数 -->
    <view class="section">
      <view class="section-title">产品参数</view>
      <view class="params-list">
        <view class="param-item" wx:if="{{product.price}}">
          <text class="param-name">价格</text>
          <view class="price-container">
            <text class="param-value price-value {{product.price === '联系销售' ? 'clickable-price' : ''}}" 
                  bindtap="{{product.price === '联系销售' ? 'showContactQRCode' : ''}}">{{product.price}}</text>
            <text class="original-price" wx:if="{{product.originalPrice && product.originalPrice !== product.price && product.originalPrice !== '联系销售'}}">¥{{product.originalPrice}}</text>
          </view>
        </view>
        
        <view class="param-item" wx:if="{{product.size}}">
          <text class="param-name">尺寸</text>
          <text class="param-value">{{product.size}}</text>
        </view>
        
        <view class="param-item" wx:if="{{product.weight}}">
          <text class="param-name">重量</text>
          <text class="param-value">{{product.weight}}</text>
        </view>
        
        <view class="param-item" wx:if="{{product.color}}">
          <text class="param-name">颜色</text>
          <text class="param-value">{{product.color}}</text>
        </view>
        
        <view class="param-item" wx:if="{{product.applicationScenario}}">
          <text class="param-name">应用场景</text>
          <text class="param-value">{{product.applicationScenario}}</text>
        </view>
        
        <block wx:for="{{product.params}}" wx:key="name">
          <view class="param-item" wx:if="{{item.name && item.value}}">
            <text class="param-name">{{item.name}}</text>
            <text class="param-value">{{item.value}}</text>
          </view>
        </block>
        
        <view class="no-params-tip" wx:if="{{!product.price && !product.size && !product.weight && !product.color && !product.applicationScenario && (!product.params || product.params.length === 0)}}">
          <text>暂无产品参数信息</text>
        </view>
      </view>
    </view>

    <!-- 3. 产品特点（放在产品参数下方，无数据时隐藏，过滤掉视频类型的特点） -->
    <view class="section" wx:if="{{product.features.length > 0 && product.hasRealFeatures}}">
      <view class="section-title">产品特点</view>
      <view class="features-list">
        <block wx:for="{{product.features}}" wx:key="index">
          <!-- 过滤掉视频类型的特点（title包含"视频"或有video字段的） -->
          <view class="feature-item" wx:if="{{item.title && !item.video && item.title.indexOf('视频') === -1}}">
            <view class="feature-title">{{item.title}}</view>
            <view class="feature-description" wx:if="{{item.description && item.description.indexOf('视频') === -1}}">{{item.description}}</view>
          </view>
        </block>
      </view>
    </view>

    <!-- 4. 产品视频展示 -->
    <view class="section" wx:if="{{productVideos && productVideos.length > 0}}">
      <view class="section-title">产品展示视频</view>
      <view class="detail-video-section">
        <view class="detail-video-item" wx:for="{{productVideos}}" wx:key="index">
          <view class="detail-video-title">{{item.title}}</view>
          <view class="video-container">
            <video wx:if="{{!item.hasError}}"
                   src="{{item.video}}"
                   class="detail-video"
                   controls="true"
                   show-center-play-btn="true"
                   object-fit="contain"
                   poster="{{item.poster || ''}}"
                   autoplay="false"
                   binderror="onVideoError"
                   data-index="{{index}}"
                   data-video-url="{{item.video}}"></video>
            <view class="video-error-tip" wx:if="{{item.hasError}}">
              <text class="error-text">视频暂时无法播放</text>
              <button class="retry-btn" bindtap="retryVideo" data-index="{{index}}">重试</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 5. 产品详情图展示（只展示详情图，不展示主图） -->
    <view class="section" wx:if="{{product.detailImages && product.detailImages.length > 0}}">
      <view class="section-title">产品详情图</view>
      <view class="detail-images-container">
        <view class="detail-image-item" 
              wx:for="{{product.detailImages}}" 
              wx:key="index"
              bindtap="previewDetailImage"
              data-url="{{item}}"
              data-index="{{index}}">
          <image src="{{item}}"
                 mode="widthFix"
                 class="detail-image"
                 bindload="onDetailImageLoad"
                 binderror="onDetailImageError"
                 lazy-load="true"></image>
          <view class="detail-image-caption">
            <text class="detail-image-number">图片 {{index + 1}}/{{product.detailImages.length}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 相似推荐产品 -->
    <view class="section similar-section">
      <view class="section-title">相似推荐</view>
      <scroll-view class="similar-products" scroll-x="true" enhanced="true" show-scrollbar="false">
        <view class="similar-item" wx:for="{{similarProducts}}" wx:key="id" bindtap="navigateToDetail" data-id="{{item.id}}">
          <view class="similar-image-container">
            <image src="{{item.imageUrl}}" mode="aspectFill" class="similar-image" lazy-load="{{true}}"></image>
          </view>
          <view class="similar-name-container">
            <text class="similar-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
    
  </view>
  
  <!-- 收藏和咨询按钮 -->
  <view class="contact-container">
    <button class="contact-btn {{product.isFavorite ? 'favorite-active' : ''}}" bindtap="toggleFavorite">
      {{product.isFavorite ? '已收藏' : '收藏'}}
    </button>
    <button class="contact-btn btn-primary" bindtap="makePhoneCall">电话咨询</button>
    <button class="contact-btn" bindtap="showContactQRCode">添加客服微信</button>
  </view>

  <!-- 微信二维码弹窗 -->
  <view class="qrcode-modal" wx:if="{{showQRCode}}" bindtap="hideContactQRCode">
    <view class="qrcode-modal-content" catchtap="">
      <view class="qrcode-header">
        <text class="qrcode-title">扫码添加客服微信</text>
        <view class="qrcode-close" bindtap="hideContactQRCode">×</view>
      </view>
      <view class="qrcode-container">
        <image src="cloud://cloud1-7gm53wok768268c9.636c-cloud1-7gm53wok768268c9-1369425968/ui/brand/qrcode小.jpg" 
               mode="aspectFit" 
               class="qrcode-image"
               show-menu-by-longpress="{{true}}"></image>
        <view class="qrcode-tips">
          <text class="qrcode-text-line">长按保存二维码</text>
          <text class="qrcode-text-line qrcode-text-highlight">微信扫码添加客服</text>
        </view>
      </view>
    </view>
  </view>
</view>
