<!--pages/fix-video-urls/fix-video-urls.wxml-->
<view class="container">
  <!-- 标题栏 -->
  <view class="header">
    <view class="title">视频URL修复工具</view>
    <view class="subtitle">修复云存储视频URL格式错误</view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="action-btn preview-btn" bindtap="previewFix" disabled="{{isFixing}}">
      预览修复效果
    </button>
    <button class="action-btn fix-btn" bindtap="startFix" disabled="{{isFixing}}">
      {{isFixing ? '修复中...' : '开始修复'}}
    </button>
  </view>

  <!-- 预览结果 -->
  <view class="preview-section" wx:if="{{showPreview && previewResults}}">
    <view class="section-title">
      <text>预览结果</text>
      <button class="close-btn" bindtap="hidePreview">×</button>
    </view>
    <view class="preview-summary">
      <text>检查了 {{previewResults.totalChecked}} 个产品</text>
      <text>需要修复 {{previewResults.needsFixCount}} 个产品</text>
    </view>
    
    <scroll-view class="preview-list" scroll-y="true">
      <view class="preview-item" wx:for="{{previewResults.preview}}" wx:key="_id">
        <view class="product-info">
          <text class="product-name">{{item.name || item._id}}</text>
          <text class="fix-status {{item.needsFix ? 'needs-fix' : 'no-fix'}}">
            {{item.needsFix ? '需要修复' : '无需修复'}}
          </text>
        </view>
        
        <view class="changes" wx:if="{{item.needsFix && item.changes}}">
          <!-- 显示变更详情 -->
          <view class="change-item" wx:if="{{item.changes.features}}">
            <text class="change-label">视频URL变更:</text>
            <view class="url-change" wx:for="{{item.changes.features.before}}" wx:for-item="feature" wx:for-index="idx" wx:key="idx">
              <view wx:if="{{feature.type === 'video' && feature.video}}">
                <text class="url-before">修复前: {{feature.video}}</text>
                <text class="url-after">修复后: {{item.changes.features.after[idx].video}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 修复结果 -->
  <view class="results-section" wx:if="{{fixResults}}">
    <view class="section-title">修复结果</view>
    <view class="results-summary">
      <view class="result-item">
        <text class="result-label">处理产品数:</text>
        <text class="result-value">{{fixResults.totalProcessed}}</text>
      </view>
      <view class="result-item">
        <text class="result-label">修复产品数:</text>
        <text class="result-value success">{{fixResults.totalFixed}}</text>
      </view>
    </view>
    
    <scroll-view class="results-list" scroll-y="true">
      <view class="result-product" wx:for="{{fixResults.results}}" wx:key="_id">
        <text class="product-name">{{item.name || item._id}}</text>
        <text class="product-status {{item.status === 'fixed' ? 'fixed' : 'unchanged'}}">
          {{item.status === 'fixed' ? '已修复' : '无变更'}}
        </text>
      </view>
    </scroll-view>
  </view>

  <!-- 日志区域 -->
  <view class="logs-section">
    <view class="section-title">
      <text>操作日志</text>
      <button class="clear-btn" bindtap="clearLogs">清空</button>
    </view>
    <scroll-view class="logs-list" scroll-y="true">
      <view class="log-item" wx:for="{{logs}}" wx:key="index">
        {{item}}
      </view>
    </scroll-view>
  </view>

  <!-- 返回按钮 -->
  <view class="footer">
    <button class="back-btn" bindtap="goBack">返回</button>
  </view>
</view>




































