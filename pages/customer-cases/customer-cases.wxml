<!--customer-cases.wxml-->
<!--客户案例展示页面-->
<!--Requirements: 2.1, 2.2, 2.3, 2.4, 2.5, 2.6-->

<navigation-bar title="定制案例" showBack="{{true}}" bindback="onBack"></navigation-bar>
<scroll-view class="scroll-container" scroll-y="true" style="padding-top: {{contentPaddingTop}}px;">
  <view class="container">
    <!-- 页面标题 - Requirements: 2.1 -->
    <view class="page-header">
      <view class="page-title">定制案例</view>
      <view class="page-subtitle">每一件都是独一无二的定制</view>
      <!-- 案例计数 - Requirements: 2.2 -->
      <view class="case-count">共 {{totalCases}} 个案例</view>
    </view>

    <!-- 加载状态 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 案例列表 - Requirements: 2.3, 2.4 -->
    <view class="case-list" wx:if="{{!loading && cases.length > 0}}">
      <view class="case-item"
            wx:for="{{cases}}"
            wx:key="_id"
            bindtap="previewImage"
            data-url="{{item.imageUrl}}">
        <view class="case-img-container">
          <image class="case-img"
                 src="{{item.imageUrl}}"
                 mode="widthFix"
                 lazy-load="{{true}}"></image>
        </view>
        <view class="case-info">
          <text class="case-title">{{item.title}}</text>
          <text class="case-description" wx:if="{{item.description}}">{{item.description}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 - Requirements: 2.6 -->
    <view class="empty-state" wx:if="{{!loading && cases.length === 0}}">
      <text>暂无案例</text>
    </view>
  </view>
</scroll-view>
