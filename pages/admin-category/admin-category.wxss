/* admin-category.wxss */
/* 分类管理页面样式 */

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #F5F5DC;
  box-sizing: border-box;
}

.content-container {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  min-height: calc(100vh - 40rpx);
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.search-icon {
  font-size: 32rpx;
  padding: 10rpx;
}

.btn-add {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 加载中样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 错误提示样式 */
.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.error-message {
  color: #F44336;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.btn-retry {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 8rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.btn-add-empty {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
}

/* 分类列表样式 */
.category-list {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item:last-child {
  border-bottom: none;
}

.category-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-icon image {
  width: 100%;
  height: 100%;
}

.category-icon.placeholder {
  font-size: 40rpx;
}

.category-details {
  flex: 1;
}

.category-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.category-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.category-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.status-active {
  background-color: #e8f5e9;
  color: #4CAF50;
}

.status-inactive {
  background-color: #ffebee;
  color: #F44336;
}

/* 操作按钮样式 */
.category-actions {
  display: flex;
  gap: 16rpx;
}

.btn-action {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 6rpx;
  line-height: 1;
}

.btn-edit {
  background-color: #2196F3;
  color: #fff;
}

.btn-delete {
  background-color: #F44336;
  color: #fff;
}

/* 列表底部统计 */
.list-footer {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}