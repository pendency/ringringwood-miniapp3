/* admin-category.wxss */
/* 分类管理页面样式 */

page {
  height: 100vh;
  overflow: hidden;
  background-color: #F5F5DC;
  padding: 0 !important;
  margin: 0;
}

.container {
  width: 100%;
  height: 100vh;
  background-color: #F5F5DC;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0;
  margin: 0;
}

.content-container {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  padding-bottom: 20rpx;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  padding: 16rpx;
  border-radius: 12rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 16rpx;
  height: 64rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 26rpx;
  color: #333;
}

.search-icon {
  font-size: 28rpx;
  padding: 8rpx;
}

.btn-add {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
}

/* 加载中样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 错误提示样式 */
.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.error-message {
  color: #F44336;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.btn-retry {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 8rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.btn-add-empty {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
}

/* 分类列表样式 */
.category-list {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

/* 分类项 - 卡片式布局 */
.category-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.category-item:last-child {
  border-bottom: none;
}

/* 分类信息区域 */
.category-info {
  margin-bottom: 16rpx;
}

/* 分类标题行：名称 + 描述 */
.category-header {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.category-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.category-desc-text {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 分类元信息行 */
.category-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #666;
  background-color: #f5f5f5;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

.status-active {
  background-color: #e8f5e9;
  color: #4CAF50;
}

.status-inactive {
  background-color: #ffebee;
  color: #F44336;
}

/* 操作按钮区域 */
.category-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.btn-action {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 8rpx;
  text-align: center;
}

.btn-edit {
  background-color: #2196F3;
  color: #fff;
}

.btn-delete {
  background-color: #F44336;
  color: #fff;
}

/* 列表底部统计 */
.list-footer {
  text-align: center;
  padding: 16rpx 0 0 0;
  color: #999;
  font-size: 24rpx;
}
