/* pages/admin-simple/admin-simple.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 导航栏样式 */
.header-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background-color: #F5F5DC;
}

.status-bar {
  width: 100%;
  background-color: #F5F5DC;
}

.custom-header {
  position: relative;
  display: flex;
  align-items: center;
  height: 44px;
  padding: 10px 15px;
  background-color: #F5F5DC;
  box-sizing: border-box;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  margin-left: -15px;
}

.back-icon {
  width: 12px;
  height: 12px;
  border-top: 2px solid #5D4037;
  border-left: 2px solid #5D4037;
  transform: rotate(-45deg);
}

.header-title {
  flex: 1;
  font-size: 18px;
  color: #5D4037;
  font-weight: bold;
  text-align: center;
  padding-right: 44px;
  letter-spacing: 2px;
}

/* 内容区域 */
.content-container {
  padding: 20rpx;
}

/* 标签页样式 */
.tabs {
  display: flex;
  background: white;
  border-radius: 10rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 25rpx 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.tab.active {
  background: linear-gradient(45deg, #007aff, #5ac8fa);
  color: white;
  font-weight: bold;
}

/* 内容区域 */
.tab-content {
  min-height: 400rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

/* 工具卡片样式 */
.tool-section {
  margin-bottom: 30rpx;
}

.tool-card {
  background: white;
  border-radius: 10rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  border: 1rpx solid #eee;
}

.tool-header {
  margin-bottom: 20rpx;
}

.tool-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.tool-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

.tool-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  flex-wrap: wrap;
}

.btn-danger {
  background: linear-gradient(45deg, #ff6b6b, #ee5a52);
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 25rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.btn-primary {
  background: linear-gradient(45deg, #007aff, #5ac8fa);
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 25rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.btn-secondary {
  background: linear-gradient(45deg, #8e8e93, #aeaeb2);
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 25rpx;
  font-size: 24rpx;
}

/* 测试信息 */
.test-info {
  background: white;
  border-radius: 10rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.test-info text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}
