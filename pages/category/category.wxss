/* category.wxss */
/* 页面整体容器 */
.container {
  height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  background-color: #F5F5DC;
}

/* 侧边菜单 */
.side-menu {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s;
  overflow: hidden;
}

.side-menu.show {
  pointer-events: auto;
  opacity: 1;
}

.menu-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.menu-content {
  position: absolute;
  top: 0;
  left: 0;
  width: 70%;
  height: 100%;
  background-color: #fff;
  transform: translateX(-100%);
  transition: transform 0.3s;
}

.side-menu.show .menu-content {
  transform: translateX(0);
}

.menu-header {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1px solid #eee;
}

.menu-logo {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.menu-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #5D4037;
}

.menu-list {
  padding: 20rpx 0;
}

.menu-item {
  padding: 30rpx;
  font-size: 32rpx;
  color: #5D4037;
  border-bottom: 1px solid #f5f5f5;
}

/* 内容区域 - 为顶部导航腾出空间 */
.content-container {
  padding-top: 64px; /* 默认留出空间，实际会由JS动态计算 */
}

.content-container .container {
  background-color: #F5F5DC;
  min-height: 100vh;
  padding: 0;
}

/* 主布局 - 左右分栏 */
.main-layout {
  display: flex;
  height: calc(100vh - 64px);
  overflow: hidden;
}

/* 左侧边栏 */
.sidebar {
  width: 160rpx;
  background-color: #fff;
  border-right: 2rpx solid rgba(139, 90, 43, 0.1);
  display: flex;
  flex-direction: column;
  box-shadow: 2rpx 0 10rpx rgba(0, 0, 0, 0.05);
}

.category-list {
  flex: 1;
  overflow-y: auto;
  padding-top: 10rpx; /* 添加顶部内边距，使类目列表整体向上调整 */
}

/* 分类项目 */
.sidebar .category-item {
  padding: 25rpx 15rpx;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.05);
  transition: all 0.3s ease;
  cursor: pointer;
  text-align: center;
  position: static !important;
  height: auto !important;
  padding-top: 25rpx !important;
  border-radius: 0 !important;
  overflow: visible !important;
}

.sidebar .category-item:first-child {
  margin-top: 10rpx; /* 为第一个类目项添加顶部间距 */
}

.sidebar .category-item:hover {
  background-color: rgba(212, 176, 140, 0.1);
}

.sidebar .category-item.active {
  background-color: #8B5A2B !important;
  background: #8B5A2B !important;
  border: 2rpx solid #8B5A2B !important;
  -webkit-background-clip: padding-box !important;
  background-clip: padding-box !important;
}

.sidebar .category-item.active:hover {
  background-color: #8B5A2B !important;
  background: #8B5A2B !important;
}

/* 针对iOS的额外样式强化 */
.category-list .category-item.active {
  background-color: #8B5A2B !important;
  background: #8B5A2B !important;
}

.main-layout .sidebar .category-item.active {
  background-color: #8B5A2B !important;
  background: #8B5A2B !important;
}

.sidebar .category-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #5D4037;
  line-height: 1.4;
  word-break: break-all;
  position: static !important;
  bottom: auto !important;
  left: auto !important;
  width: auto !important;
  padding: 0 !important;
}

.sidebar .category-item.active .category-name {
  color: #fff !important;
  color: white !important;
  background-color: transparent !important;
  background: transparent !important;
}

/* 针对iOS的文字颜色强化 */
.category-list .category-item.active .category-name {
  color: #fff !important;
  color: white !important;
}

.main-layout .sidebar .category-item.active .category-name {
  color: #fff !important;
  color: white !important;
}

/* 最强优先级 - 使用属性选择器 */
.category-item[style*="background-color: #8B5A2B"] {
  background-color: #8B5A2B !important;
  background: #8B5A2B !important;
}

.category-name[style*="color: #fff"] {
  color: #fff !important;
  color: white !important;
}

/* 右侧内容区域 */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #F5F5DC;
  overflow: hidden;
}

/* 当前分类信息 */
.current-category {
  padding: 25rpx 30rpx;
  background-color: #fff;
  border-bottom: 2rpx solid rgba(139, 90, 43, 0.1);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.current-category-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #5D4037;
  margin-bottom: 12rpx;
}

.current-category-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.current-category-desc {
  font-size: 26rpx;
  color: #8B5A2B;
  line-height: 1.5;
  opacity: 0.9;
  flex: 1;
}

.product-count {
  font-size: 24rpx;
  color: #D4B08C;
  background-color: rgba(212, 176, 140, 0.15);
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  display: inline-block;
  font-weight: 500;
  margin-left: 16rpx;
  white-space: nowrap;
}

/* 产品列表 */
.product-list {
  flex: 1;
  padding: 20rpx 30rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr; /* 修改为单列布局 */
  gap: 30rpx; /* 增加产品间距 */
  padding: 30rpx 0 60rpx 0; /* 顶部内边距控制产品图片上方留白 */
}

.product-item {
  background-color: #fff;
  border-radius: 0; /* 移除圆角，改为直角矩形 */
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
  margin-bottom: 10rpx; /* 添加底部间距 */
}

.product-img-container {
  width: 100%;
  height: 0;
  padding-top: 75%; /* 4:3 比例 (3/4 = 0.75 = 75%) */
  position: relative;
  overflow: hidden;
}

.product-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-info {
  padding: 24rpx;
  position: relative;
}

.product-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #5D4037;
  display: block;
  margin-bottom: 8rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #8B5A2B;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}

.product-price {
  font-size: 26rpx;
  font-weight: bold;
  color: #D4B08C;
  display: block;
}

/* 收藏按钮 */
.favorite-btn {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  background-color: #F5F5DC;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #8B5A2B;
  z-index: 2;
}

.favorite-btn:active {
  opacity: 0.8;
}

.favorite-btn .favorite-active {
  color: #D4B08C;
  font-weight: bold;
}

/* 加载状态 */
.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #8B5A2B;
}

/* 空状态优化 */
.empty-state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 30rpx;
  color: #8B5A2B;
  font-size: 28rpx;
}

/* 加载更多容器 - Requirements 2.3 */
.load-more-container {
  padding: 30rpx 0 60rpx 0;
  text-align: center;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  color: #8B5A2B;
  font-size: 26rpx;
}

.loading-more text {
  margin-left: 10rpx;
}

.no-more {
  padding: 20rpx;
  color: #D4B08C;
  font-size: 24rpx;
  text-align: center;
}

.load-more-hint {
  padding: 20rpx;
  color: #8B5A2B;
  font-size: 24rpx;
  text-align: center;
  opacity: 0.7;
} 


/* ========== 搜索栏样式 - Feature: category-filter-search ========== */
/* Requirements: 4.1 */

.search-filter-container {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #fff;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.1);
  gap: 12rpx;
}

.search-bar-container {
  flex: 1;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #F5F5DC;
  border-radius: 30rpx;
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.15);
}

.search-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #5D4037;
  height: 36rpx;
  line-height: 36rpx;
}

.search-placeholder {
  color: #D4B08C;
  font-size: 24rpx;
}

.search-clear-btn {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(139, 90, 43, 0.2);
  border-radius: 50%;
  margin-left: 10rpx;
}

.clear-icon {
  font-size: 24rpx;
  color: #5D4037;
  font-weight: bold;
  line-height: 1;
}

.search-clear-btn:active {
  background-color: rgba(139, 90, 43, 0.3);
}

/* ========== 筛选按钮样式 - Requirements: 1.1, 1.6 ========== */

.filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  background-color: #F5F5DC;
  border-radius: 30rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.15);
  position: relative;
  transition: all 0.3s ease;
}

.filter-btn.active {
  background-color: #8B5A2B;
  border-color: #8B5A2B;
}

.filter-btn.active .filter-btn-text {
  color: #fff;
}

.filter-btn.has-filters {
  border-color: #8B5A2B;
}

.filter-btn-text {
  font-size: 22rpx;
  color: #5D4037;
  font-weight: 500;
}

.filter-indicator {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 12rpx;
  height: 12rpx;
  background-color: #D4B08C;
  border-radius: 50%;
}

.filter-btn:active {
  opacity: 0.8;
}

/* ========== 筛选面板样式 - Requirements: 1.1, 1.4, 1.5 ========== */

.filter-panel {
  max-height: 0;
  overflow: hidden;
  background-color: #fff;
  border-bottom: 2rpx solid rgba(139, 90, 43, 0.1);
  transition: max-height 0.3s ease, padding 0.3s ease;
  padding: 0 30rpx;
}

.filter-panel.show {
  max-height: 800rpx;
  padding: 20rpx 30rpx;
  overflow-y: auto;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-section-title {
  font-size: 26rpx;
  color: #5D4037;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-options-wrap {
  gap: 10rpx;
}

.filter-option {
  padding: 10rpx 18rpx;
  background-color: #F5F5DC;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #5D4037;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.filter-option.option-unlimited {
  background-color: rgba(139, 90, 43, 0.08);
}

.filter-option.selected {
  background-color: #8B5A2B;
  color: #fff;
  border-color: #8B5A2B;
}

.filter-option:active {
  opacity: 0.8;
}

.filter-actions {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(139, 90, 43, 0.1);
}

.clear-all-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  background-color: transparent;
  border: 2rpx solid #D4B08C;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #D4B08C;
}

.clear-all-btn:active {
  background-color: rgba(212, 176, 140, 0.1);
}

/* ========== 激活筛选指示器样式 - Requirements: 5.2 ========== */

.active-filters-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 30rpx;
  background-color: rgba(245, 245, 220, 0.5);
  border-bottom: 2rpx solid rgba(139, 90, 43, 0.1);
}

.active-filter-tag {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: #8B5A2B;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
}

.tag-close {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: bold;
  opacity: 0.8;
}

.tag-close:active {
  opacity: 1;
}

/* ========== 筛选空状态样式 - Requirements: 6.1 ========== */

.filter-empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.filter-empty-icon {
  font-size: 80rpx;
  margin-bottom: 30rpx;
}

.filter-empty-text {
  font-size: 32rpx;
  color: #5D4037;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.filter-empty-hint {
  font-size: 26rpx;
  color: #8B5A2B;
  margin-bottom: 40rpx;
  opacity: 0.8;
}

.filter-empty-action {
  background-color: #8B5A2B;
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.filter-empty-action:active {
  opacity: 0.8;
}

/* ========== 搜索栏样式结束 ========== */


/* ========== 排序选择器样式 - Requirements: 7.1, 7.7 ========== */

.sort-selector {
  position: relative;
}

.sort-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 14rpx;
  background-color: #F5F5DC;
  border-radius: 30rpx;
  border: 1rpx solid rgba(139, 90, 43, 0.15);
  transition: all 0.3s ease;
  min-width: 100rpx;
}

.sort-btn.active {
  background-color: #8B5A2B;
  border-color: #8B5A2B;
}

.sort-btn.active .sort-btn-text,
.sort-btn.active .sort-btn-arrow {
  color: #fff;
}

.sort-btn.has-sort {
  border-color: #8B5A2B;
}

.sort-btn-text {
  font-size: 22rpx;
  color: #5D4037;
  font-weight: 500;
  margin-right: 6rpx;
}

.sort-btn-arrow {
  font-size: 16rpx;
  color: #5D4037;
  transition: transform 0.3s ease;
}

.sort-btn-arrow.up {
  transform: rotate(180deg);
}

.sort-btn:active {
  opacity: 0.8;
}

/* 排序下拉菜单 */
.sort-dropdown {
  position: absolute;
  top: calc(100% + 8rpx);
  right: 0;
  min-width: 160rpx;
  background-color: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10rpx);
  transition: all 0.2s ease;
}

.sort-dropdown.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.sort-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #5D4037;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.1);
  transition: background-color 0.2s ease;
}

.sort-option:last-child {
  border-bottom: none;
}

.sort-option:first-child {
  border-radius: 12rpx 12rpx 0 0;
}

.sort-option:last-child {
  border-radius: 0 0 12rpx 12rpx;
}

.sort-option:only-child {
  border-radius: 12rpx;
}

.sort-option.selected {
  background-color: rgba(139, 90, 43, 0.1);
  color: #8B5A2B;
  font-weight: 500;
}

.sort-option:active {
  background-color: rgba(139, 90, 43, 0.15);
}

.sort-check {
  font-size: 22rpx;
  color: #8B5A2B;
  font-weight: bold;
}

/* 排序下拉菜单遮罩 */
.sort-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background-color: transparent;
}

/* ========== 排序选择器样式结束 ========== */


/* ========== 案例入口按钮样式 - Requirements: 1.2 ========== */
/* 样式参考首页"立即选购"按钮 */

.case-entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #8B5A2B;
  color: #fff;
  padding: 24rpx 30rpx;
  border-radius: 0;
  margin: 0;
  box-shadow: none;
}

.case-entry:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.case-entry-text {
  font-size: 30rpx;
  font-weight: bold;
}

.case-entry-arrow {
  font-size: 32rpx;
  font-weight: bold;
}

/* ========== 案例入口按钮样式结束 ========== */
