<!--category.wxml-->
<view class="container">
  <!-- 导航栏 -->
  <navigation-bar title="年轮环环" showMenu="{{true}}" bindtoggle="toggleMenu" />
  
  <!-- 侧边菜单 -->
  <view class="side-menu {{showMenu ? 'show' : ''}}">
    <view class="menu-mask" bindtap="toggleMenu"></view>
    <view class="menu-content">
      <view class="menu-header">
        <image class="menu-logo" src="cloud://cloud1-7gm53wok768268c9.636c-cloud1-7gm53wok768268c9-1369425968/ui/brand/brand.jpeg" mode="aspectFit" bindtap="onLogoTap"></image>
        <text class="menu-title">年轮环环</text>
      </view>
      <view class="menu-list">
        <view class="menu-item" bindtap="navigateToHome">
          <text>首页</text>
        </view>
        <view class="menu-item" bindtap="navigateToCategory" data-type="原木经典">
          <text>原木经典</text>
        </view>
        <view class="menu-item" bindtap="navigateToCategory" data-type="树脂美学">
          <text>树脂美学</text>
        </view>
        <view class="menu-item" bindtap="navigateToCategory" data-type="玩趣设计">
          <text>玩趣设计</text>
        </view>
        <view class="menu-item" bindtap="navigateToCategory" data-type="高定专属">
          <text>高定专属</text>
        </view>
        <view class="menu-item" bindtap="navigateToCategory" data-type="桌架专区">
          <text>桌架专区</text>
        </view>
        <view class="menu-item" bindtap="navigateToFavorite">
          <text>收藏</text>
        </view>
        <view class="menu-item" bindtap="navigateToContact">
          <text>选购</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-container" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <!-- 左右分栏布局 -->
    <view class="main-layout">
      <!-- 左侧分类列表 -->
      <view class="sidebar">
        <scroll-view class="category-list"
                     scroll-y="{{true}}"
                     id="category-list"
                     scroll-into-view="{{scrollIntoView}}"
                     scroll-with-animation="{{true}}">
          <view class="category-item {{activeTab === index ? 'active' : ''}}"
                wx:for="{{categories}}"
                wx:key="_id"
                wx:for-index="index"
                bindtap="switchTab"
                data-index="{{index}}"
                data-category-id="{{item._id}}"
                data-category-name="{{item.name}}"
                id="category-item-{{index}}"
                style="{{activeTab === index ? 'background-color: #8B5A2B !important; background: #8B5A2B !important;' : ''}}">
            <view class="category-name" style="{{activeTab === index ? 'color: #fff !important; color: white !important;' : ''}}">{{item.name}}</view>
          </view>
        </scroll-view>
      </view>
      
      <!-- 右侧产品内容区域 -->
      <view class="content-area">
        <!-- 当前分类信息 -->
        <view class="current-category" wx:if="{{categories[activeTab]}}">
          <view class="current-category-name">{{categories[activeTab].name}}</view>
          <view class="current-category-desc">{{categories[activeTab].description}}</view>
          <view class="product-count">共 {{totalProducts}} 件产品</view>
        </view>
        
        <!-- 加载状态 -->
        <view class="loading" wx:if="{{loading}}">
          <text>加载中...</text>
        </view>
        
        <!-- 产品列表 -->
        <scroll-view class="product-list" 
                     scroll-y="{{true}}" 
                     enable-back-to-top="{{true}}"
                     wx:if="{{!loading && products.length > 0}}">
          <view class="product-grid">
            <view class="product-item" 
                  wx:for="{{products}}" 
                  wx:key="_id" 
                  bindtap="navigateToDetail" 
                  data-id="{{item._id}}">
              <view class="product-img-container">
                <image class="product-img" 
                       src="{{item.imageUrls[0]}}" 
                       mode="aspectFill"
                       binderror="onImageError"
                       data-id="{{item._id}}"
                       data-index="{{index}}"></image>
              </view>
              <view class="product-info">
                <text class="product-name">{{item.name}}</text>
                <text class="product-price">{{item.price === '联系销售' ? '联系销售' : '¥' + item.price + '起'}}</text>
                <view class="favorite-btn" catchtap="toggleFavorite" data-id="{{item._id}}" data-item="{{item}}">
                  <text class="{{item.isFavorite ? 'favorite-active' : ''}}">{{item.isFavorite ? '已收藏' : '收藏'}}</text>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
        
        <!-- 空状态 -->
        <view class="empty-state" wx:if="{{!loading && products.length === 0}}">
          <text>暂无产品</text>
        </view>
      </view>
    </view>
  </view>
</view> 