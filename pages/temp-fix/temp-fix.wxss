/* pages/temp-fix/temp-fix.wxss */
.container {
  padding: 40rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding: 40rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.buttons {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 40rpx;
}

.fix-btn,
.preview-btn,
.single-btn {
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: white;
}

.fix-btn {
  background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
}

.preview-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.single-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

button[disabled] {
  background: #ccc !important;
  color: #999 !important;
}

.result {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.result-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.result-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}




































