/* admin-product.wxss */
/* 产品管理页面样式 */

.container {
  width: 100%;
  min-height: 100vh;
  background-color: #F5F5DC;
  box-sizing: border-box;
}

.content-container {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 底部安全区域 */
.safe-area-bottom {
  height: 60rpx;
  width: 100%;
}

/* 筛选栏样式 */
.filter-bar {
  background-color: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.search-input-wrapper {
  flex: 1;
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 0 20rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.search-icon {
  font-size: 32rpx;
  padding: 10rpx;
}

.btn-add {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 0 30rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 20rpx;
}

.filter-item {
  flex: 1;
}

.filter-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 加载中样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 错误提示样式 */
.error-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.error-message {
  color: #F44336;
  font-size: 28rpx;
  margin-bottom: 30rpx;
  text-align: center;
}

.btn-retry {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 8rpx;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.btn-add-empty {
  background-color: #8B5A2B;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
}

/* 产品列表样式 */
.product-list {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.product-item {
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-item:last-child {
  border-bottom: none;
}

.product-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.product-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.product-image image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #ccc;
}

.product-details {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-category {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.product-price {
  margin-bottom: 8rpx;
}

.price-current {
  font-size: 32rpx;
  font-weight: bold;
  color: #F44336;
}

.price-original {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 12rpx;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  background-color: #f5f5f5;
  color: #666;
}

.tag-hot {
  background-color: #ffebee;
  color: #F44336;
}

.tag-new {
  background-color: #e3f2fd;
  color: #2196F3;
}

.tag-recommend {
  background-color: #fff3e0;
  color: #FF9800;
}

.status-active {
  background-color: #e8f5e9;
  color: #4CAF50;
}

.status-inactive {
  background-color: #ffebee;
  color: #F44336;
}

/* 操作按钮样式 */
.product-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.btn-action {
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 6rpx;
  line-height: 1;
}

.btn-status {
  min-width: 100rpx;
}

.btn-online {
  background-color: #4CAF50;
  color: #fff;
}

.btn-offline {
  background-color: #FF9800;
  color: #fff;
}

.btn-edit {
  background-color: #2196F3;
  color: #fff;
}

.btn-delete {
  background-color: #F44336;
  color: #fff;
}

/* 加载更多样式 */
.load-more {
  padding: 30rpx;
  text-align: center;
}

.loading-more,
.no-more {
  color: #999;
  font-size: 24rpx;
}

.btn-load-more {
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
}

/* 列表底部统计 */
.list-footer {
  text-align: center;
  padding: 20rpx;
  color: #999;
  font-size: 24rpx;
}
