<!--pages/fix-database/fix-database.wxml-->
<view class="container">
  <view class="header">
    <text class="title">数据库URL修复工具</text>
    <text class="subtitle">修复数据库中的云存储URL格式错误</text>
  </view>

  <view class="action-section">
    <button 
      class="fix-btn {{isFixing ? 'fixing' : ''}}" 
      bindtap="startFix"
      disabled="{{isFixing}}"
    >
      {{isFixing ? '修复中...' : '开始修复'}}
    </button>
    
    <button class="clear-btn" bindtap="clearLogs">清空日志</button>
  </view>

  <view class="result-section" wx:if="{{fixResult}}">
    <view class="result-header">修复结果</view>
    <view class="result-item">
      <text class="label">总产品数:</text>
      <text class="value">{{fixResult.totalProducts}}</text>
    </view>
    <view class="result-item">
      <text class="label">修复产品数:</text>
      <text class="value success">{{fixResult.fixedProducts}}</text>
    </view>
    <view class="result-item">
      <text class="label">修复状态:</text>
      <text class="value {{fixResult.success ? 'success' : 'error'}}">
        {{fixResult.success ? '成功' : '失败'}}
      </text>
    </view>
  </view>

  <view class="logs-section">
    <view class="logs-header">修复日志</view>
    <scroll-view class="logs-content" scroll-y="true">
      <view class="log-item" wx:for="{{logs}}" wx:key="index">
        <text class="log-text">{{item}}</text>
      </view>
      <view wx:if="{{logs.length === 0}}" class="empty-logs">
        暂无日志
      </view>
    </scroll-view>
  </view>

  <view class="footer">
    <button class="back-btn" bindtap="goBack">返回</button>
  </view>
</view>