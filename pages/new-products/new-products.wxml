<!--new-products.wxml-->
<navigation-bar title="灵感上新" bindback="onBack"></navigation-bar>
<view class="content-container" style="padding-top: {{contentPaddingTop}}px;">
  <view class="container">
    <!-- 页面标题 -->
    <view class="page-header">
      <view class="page-title">灵感上新</view>
      <view class="page-subtitle">每一件都值得探索</view>
      <view class="product-count">共 {{totalProducts}} 件产品</view>
    </view>
    
    <!-- 加载状态 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    
    <!-- 产品列表 -->
    <view class="product-list" wx:if="{{!loading && products.length > 0}}">
      <view class="product-item" 
            wx:for="{{products}}" 
            wx:key="_id" 
            bindtap="navigateToDetail" 
            data-id="{{item._id}}">
        <view class="product-img-container">
          <image class="product-img" 
                 src="{{item.imageUrls[0]}}" 
                 mode="aspectFill"
                 lazy-load="{{true}}"></image>
          <view class="new-tag">NEW</view>
        </view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.price}}起</text>
          <view class="favorite-btn" catchtap="toggleFavorite" data-id="{{item._id}}" data-item="{{item}}">
            <text class="{{item.isFavorite ? 'favorite-active' : ''}}">{{item.isFavorite ? '已收藏' : '收藏'}}</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && products.length === 0}}">
      <text>暂无新品</text>
    </view>
  </view>
</view>