<!-- admin.wxml -->
<view class="container">
  <!-- 调试信息区域 - 仅在开发时显示，可通过 showDebug 控制 -->
  <view class="debug-info" wx:if="{{showDebug}}">
    <text class="debug-title">调试信息:</text>
    <text class="debug-item">加载状态: {{loading ? '加载中' : '已完成'}}</text>
    <text class="debug-item">产品数量: {{products.length}}</text>
    <text class="debug-item">分类数量: {{categories.length}}</text>
    <text class="debug-item">当前标签: {{activeTab}}</text>
  </view>

  <!-- 导航栏 -->
  <navigation-bar title="管理后台" showBack="{{true}}" bindback="navigateBack" />
  
  <!-- 内容区域 -->
  <view class="content-container" style="padding-top: {{contentPaddingTop}}px;">
    <!-- 标签页导航 -->
    <view class="tabs">
      <view class="tab {{activeTab === 'products' ? 'active' : ''}}" 
            bindtap="switchTab" 
            data-tab="products">产品管理</view>
      <view class="tab {{activeTab === 'categories' ? 'active' : ''}}" 
            bindtap="switchTab" 
            data-tab="categories">分类管理</view>
      <view class="tab {{activeTab === 'banners' ? 'active' : ''}}" 
            bindtap="switchTab" 
            data-tab="banners">轮播图管理</view>
      <view class="tab {{activeTab === 'migration' ? 'active' : ''}}" 
            bindtap="switchTab" 
            data-tab="migration">数据迁移</view>
      <view class="tab {{activeTab === 'tools' ? 'active' : ''}}" 
            bindtap="switchTab" 
            data-tab="tools">工具</view>
    </view>
    
    <!-- 加载中提示 -->
    <view class="loading" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
    
    <!-- 默认显示内容 -->
    <view class="default-content" wx:if="{{!activeTab}}">
      <view class="welcome-section">
        <view class="welcome-title">欢迎使用管理后台</view>
        <view class="welcome-desc">请选择上方标签页开始管理操作</view>
      </view>
    </view>
    
    <!-- 产品管理 -->
    <view class="tab-content" wx:if="{{activeTab === 'products'}}">
      <view class="section-title">产品管理</view>
      
      <!-- 产品管理入口 - Requirements: 5.1 -->
      <view class="tool-section">
        <view class="tool-card">
          <view class="tool-header">
            <view class="tool-title">产品管理系统</view>
            <view class="tool-desc">新增、编辑、删除产品，管理上架下架状态</view>
          </view>
          <view class="tool-actions">
            <button class="btn btn-primary" bindtap="goToProductAdmin">打开产品管理</button>
          </view>
        </view>
      </view>
      
      <view class="divider"></view>
      
      <view class="section-title">产品数据导入</view>
      
      <!-- 产品数据导入 -->
      <view class="import-section">
        <view class="import-title">CSV文件导入</view>
        <view class="import-desc">从CSV文件导入产品数据</view>
        
        <view class="import-status" wx:if="{{importStatus}}">
          <text class="{{importSuccess ? 'success' : 'error'}}">{{importStatus}}</text>
        </view>
        
        <view class="import-file-section" wx:if="{{!csvUploaded}}">
          <view class="import-file-desc">请先上传产品数据CSV文件:</view>
          <button class="btn" bindtap="chooseCSVFile">选择CSV文件</button>
        </view>
        
        <view class="import-file-section" wx:if="{{csvUploaded}}">
          <view class="import-file-info">
            <text class="success">✓ 已上传: {{csvFileName}}</text>
          </view>
          <view class="import-file-actions">
            <button class="btn btn-secondary" bindtap="resetCSVUpload">重新上传</button>
            <button class="btn btn-warning" bindtap="clearCSVFile">清除文件</button>
          </view>
        </view>
        
        <view class="action-buttons">
          <button class="btn btn-primary" bindtap="importProducts" disabled="{{!csvUploaded || importRunning}}">
            {{importRunning ? '导入中...' : '导入产品数据'}}
          </button>
          <button class="btn" bindtap="viewImportLog" wx:if="{{importLogExists}}">查看导入日志</button>
          <button class="btn btn-error" bindtap="viewImportErrors" wx:if="{{importErrorsExist}}">查看错误</button>
        </view>
      </view>
      
      <!-- 数据迁移 -->
      <view class="migration-section">
        <view class="import-title">数据迁移到云开发</view>
        <view class="import-desc">将本地mock数据迁移到云开发数据库</view>
        
        <view class="import-status" wx:if="{{migrationStatus}}">
          <text class="{{migrationSuccess ? 'success' : 'error'}}">{{migrationStatus}}</text>
        </view>
        
        <view class="action-buttons">
          <button class="btn btn-primary" bindtap="testCloudFunction">测试云函数连接</button>
          <button class="btn btn-warning" bindtap="executeMigration" disabled="{{migrationRunning}}">
            {{migrationRunning ? '迁移中...' : '执行数据迁移'}}
          </button>
        </view>
      </view>
      
      <view class="divider"></view>
      
      <view class="product-list">
        <block wx:for="{{products}}" wx:key="_id">
          <view class="product-item {{currentProduct._id === item._id ? 'selected' : ''}}" 
                bindtap="selectProduct" 
                data-id="{{item._id}}">
            <view class="product-name">{{item.name}}</view>
            <view class="product-desc">{{item.description}}</view>
          </view>
        </block>
      </view>
      
      <view class="action-buttons">
        <button class="btn" bindtap="chooseImage" data-type="product">上传产品图片</button>
      </view>
    </view>
    
    <!-- 分类管理 -->
    <view class="tab-content" wx:if="{{activeTab === 'categories'}}">
      <view class="section-title">分类管理</view>
      
      <!-- 分类管理入口 -->
      <view class="tool-section">
        <view class="tool-card">
          <view class="tool-header">
            <view class="tool-title">分类管理系统</view>
            <view class="tool-desc">新增、编辑、删除产品分类</view>
          </view>
          <view class="tool-actions">
            <button class="btn btn-primary" bindtap="goToCategoryAdmin">打开分类管理</button>
          </view>
        </view>
      </view>
      
      <view class="divider"></view>
      
      <view class="section-title">快速预览</view>
      <view class="category-list">
        <block wx:for="{{categories}}" wx:key="_id">
          <view class="category-item {{currentCategory._id === item._id ? 'selected' : ''}}" 
                bindtap="selectCategory" 
                data-id="{{item._id}}">
            <view class="category-name">{{item.name}}</view>
            <view class="category-desc">{{item.description || '无描述'}}</view>
          </view>
        </block>
      </view>
      
      <view class="action-buttons">
        <button class="btn" bindtap="chooseImage" data-type="category-icon">上传分类图标</button>
        <button class="btn" bindtap="chooseImage" data-type="category-image">上传分类图片</button>
      </view>
    </view>
    
    <!-- 轮播图管理 -->
    <view class="tab-content" wx:if="{{activeTab === 'banners'}}">
      <view class="section-title">轮播图管理</view>
      
      <!-- 新增轮播图 -->
      <view class="tool-section">
        <view class="tool-card">
          <view class="tool-header">
            <view class="tool-title">新增轮播图</view>
            <view class="tool-desc">上传新的轮播图并设置标题和副标题</view>
          </view>
          <view class="tool-actions">
            <button class="btn btn-primary" bindtap="showAddBannerForm">新增轮播图</button>
          </view>
        </view>
      </view>
      
      <view class="divider"></view>
      
      <!-- 轮播图列表 -->
      <view class="section-title">轮播图列表</view>
      
      <view class="loading" wx:if="{{bannersLoading}}">
        <text>加载中...</text>
      </view>
      
      <view class="banner-list" wx:if="{{!bannersLoading}}">
        <view class="empty-tip" wx:if="{{banners.length === 0}}">
          <text>暂无轮播图，请点击上方按钮添加</text>
        </view>
        
        <block wx:for="{{banners}}" wx:key="_id">
          <view class="banner-item">
            <view class="banner-preview">
              <image class="banner-image" src="{{item.image}}" mode="aspectFill"></image>
              <view class="banner-order">{{item.order || 999}}</view>
              <view class="banner-status {{item.status === 1 ? 'active' : 'inactive'}}">
                {{item.status === 1 ? '启用' : '禁用'}}
              </view>
            </view>
            <view class="banner-info">
              <view class="banner-title-text">{{item.title || '未设置标题'}}</view>
              <view class="banner-subtitle-text">{{item.subtitle || '未设置副标题'}}</view>
            </view>
            <view class="banner-actions">
              <button class="btn btn-small" bindtap="editBanner" data-id="{{item._id}}">编辑</button>
              <button class="btn btn-small btn-error" bindtap="deleteBanner" data-id="{{item._id}}">删除</button>
            </view>
          </view>
        </block>
      </view>
      
      <view class="action-buttons">
        <button class="btn" bindtap="refreshBanners">刷新列表</button>
      </view>
    </view>
    
    <!-- 轮播图编辑弹窗 -->
    <view class="modal-overlay" wx:if="{{showBannerForm}}" bindtap="closeBannerForm">
      <view class="modal-content banner-form" catchtap="">
        <view class="modal-header">
          <text class="modal-title">{{editingBannerId ? '编辑轮播图' : '新增轮播图'}}</text>
          <view class="modal-close" bindtap="closeBannerForm">×</view>
        </view>
        
        <view class="form-group">
          <view class="form-label">轮播图图片</view>
          <view class="banner-image-upload" wx:if="{{!bannerFormData.image}}" bindtap="chooseBannerImage">
            <text class="upload-icon">+</text>
            <text class="upload-text">点击上传图片</text>
          </view>
          <view class="banner-image-preview" wx:if="{{bannerFormData.image}}">
            <image src="{{bannerFormData.image}}" mode="aspectFill"></image>
            <view class="image-change" bindtap="chooseBannerImage">更换图片</view>
          </view>
        </view>
        
        <view class="form-group">
          <view class="form-label">标题（左下角显示）</view>
          <input class="form-input" 
                 placeholder="例如：✧ 原木经典" 
                 value="{{bannerFormData.title}}"
                 bindinput="onBannerTitleInput" />
        </view>
        
        <view class="form-group">
          <view class="form-label">副标题（左下角显示）</view>
          <input class="form-input" 
                 placeholder="例如：厚实整板，稳重大气" 
                 value="{{bannerFormData.subtitle}}"
                 bindinput="onBannerSubtitleInput" />
        </view>
        
        <view class="form-group">
          <view class="form-label">排序权重（数字越小越靠前）</view>
          <input class="form-input" 
                 type="number"
                 placeholder="默认999" 
                 value="{{bannerFormData.order}}"
                 bindinput="onBannerOrderInput" />
        </view>
        
        <view class="form-group">
          <view class="form-label">状态</view>
          <view class="status-switch">
            <switch checked="{{bannerFormData.status === 1}}" 
                    bindchange="onBannerStatusChange"
                    color="#4CAF50" />
            <text class="status-text">{{bannerFormData.status === 1 ? '启用' : '禁用'}}</text>
          </view>
        </view>
        
        <view class="form-group">
          <view class="form-label">关联产品ID（可选）</view>
          <input class="form-input" 
                 placeholder="点击轮播图跳转到的产品ID" 
                 value="{{bannerFormData.productId}}"
                 bindinput="onBannerProductIdInput" />
        </view>
        
        <view class="modal-actions">
          <button class="btn btn-cancel" bindtap="closeBannerForm">取消</button>
          <button class="btn btn-primary" bindtap="saveBanner" disabled="{{bannerSaving}}">
            {{bannerSaving ? '保存中...' : '保存'}}
          </button>
        </view>
      </view>
    </view>

    <!-- 数据迁移 -->
    <view class="tab-content" wx:if="{{activeTab === 'migration'}}">
      <view class="section-title">数据迁移到云开发</view>
      
      <!-- 云函数测试 -->
      <view class="migration-section">
        <view class="import-title">1. 云函数连接测试</view>
        <view class="import-desc">测试云函数是否正常工作</view>
        
        <view class="action-buttons">
          <button class="btn btn-primary" bindtap="testCloudFunction">测试云函数连接</button>
        </view>
      </view>
      
      <!-- 数据迁移 -->
      <view class="migration-section">
        <view class="import-title">2. 执行数据迁移</view>
        <view class="import-desc">将本地mock数据迁移到云开发数据库</view>
        
        <view class="import-status" wx:if="{{migrationStatus}}">
          <text class="{{migrationSuccess ? 'success' : 'error'}}">{{migrationStatus}}</text>
        </view>
        
        <view class="action-buttons">
          <button class="btn btn-warning" bindtap="executeMigration" disabled="{{migrationRunning}}">
            {{migrationRunning ? '迁移中...' : '执行数据迁移'}}
          </button>
        </view>
      </view>

      <!-- 视频URL迁移 -->
      <view class="migration-section">
        <view class="import-title">3. 视频URL迁移</view>
        <view class="import-desc">将视频URL迁移到云存储路径</view>
        
        <view class="action-buttons">
          <button class="btn btn-success" bindtap="goToVideoMigration">
            打开视频迁移管理
          </button>
        </view>
      </view>

      <!-- 使用说明 -->
      <view class="migration-section">
        <view class="import-title">使用说明</view>
        <view class="instructions">
          <text>1. 首先点击"测试云函数连接"确保云函数正常</text>
          <text>2. 确保在云开发控制台创建了 categories 和 products 集合</text>
          <text>3. 点击"执行数据迁移"开始迁移数据</text>
          <text>4. 迁移完成后可以在云开发控制台查看数据</text>
        </view>
      </view>
    </view>
    
    <!-- 图片预览和上传确认 -->
    <view class="upload-preview" wx:if="{{tempImages.length > 0}}">
      <view class="preview-title">图片预览</view>
      <view class="preview-images">
        <block wx:for="{{tempImages}}" wx:key="*this">
          <image class="preview-image" src="{{item}}" mode="aspectFit"></image>
        </block>
      </view>
      
      <view class="preview-actions">
        <button class="btn btn-cancel" bindtap="cancelUpload">取消</button>
        <button class="btn btn-confirm" bindtap="confirmUpload">确认上传</button>
      </view>
    </view>
    
    <!-- 工具标签页 -->
    <view class="tab-content" wx:if="{{activeTab === 'tools'}}">
      <view class="section-title">系统工具</view>
      
      <!-- 数据库修复工具 -->
      <view class="tool-section">
        <view class="tool-card">
          <view class="tool-header">
            <view class="tool-title">数据库URL修复</view>
            <view class="tool-desc">修复数据库中的云存储URL格式错误</view>
          </view>
          <view class="tool-actions">
            <button class="btn btn-primary" bindtap="goToFixDatabase">打开修复工具</button>
          </view>
        </view>
      </view>
      
      <!-- 视频迁移工具 -->
      <view class="tool-section">
        <view class="tool-card">
          <view class="tool-header">
            <view class="tool-title">视频迁移管理</view>
            <view class="tool-desc">管理视频文件的云存储迁移</view>
          </view>
          <view class="tool-actions">
            <button class="btn btn-primary" bindtap="goToVideoMigration">打开迁移工具</button>
          </view>
        </view>
      </view>
      
      <!-- 云存储测试工具 -->
      <view class="tool-section">
        <view class="tool-card">
          <view class="tool-header">
            <view class="tool-title">云存储测试</view>
            <view class="tool-desc">测试云存储视频播放功能</view>
          </view>
          <view class="tool-actions">
            <button class="btn btn-primary" bindtap="goToCloudVideoTest">打开测试工具</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view> 