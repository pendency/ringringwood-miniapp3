/* components/navigation-bar/navigation-bar.wxss */
.header-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  background-color: #F5F5DC;
}

.status-bar {
  width: 100%;
  background-color: #F5F5DC;
}

.custom-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 10px 15px;
  background-color: #F5F5DC;
  box-sizing: border-box;
}

/* 左侧区域 */
.left-section {
  display: flex;
  align-items: center;
  width: 44px;
  height: 44px;
}

/* 右侧区域（占位） */
.right-section {
  width: 44px;
  height: 44px;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
}

.back-icon {
  width: 12px;
  height: 12px;
  border-top: 2px solid #5D4037;
  border-left: 2px solid #5D4037;
  transform: rotate(-45deg);
}

.header-title {
  flex: 1;
  font-size: 18px;
  color: #5D4037;
  font-weight: bold;
  text-align: center;
  letter-spacing: 2px; /* 添加字体间距，与分类页一致 */
}

/* 菜单按钮样式 */
.menu-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: transparent; /* 透明背景，去掉圆圈 */
}

.menu-icon {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 20px;
  height: 14px;
}

.menu-line {
  width: 100%;
  height: 2px;
  background-color: #5D4037;
  border-radius: 1px;
  transition: all 0.3s ease;
}

.menu-button:active .menu-line {
  background-color: #4D3926;
}