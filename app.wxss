/**app.wxss**/
page {
  background-color: #F5F5DC;
  font-family: "Microsoft YaHei", sans-serif;
  color: #5D4037;
  font-size: 28rpx;
  height: 100vh;
  overflow: hidden;
  padding: 0;
  margin: 0;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0;
  margin: 0;
} 

/* 通用标题样式 */
.title {
  font-family: "FangZheng Hei", "Microsoft YaHei", sans-serif;
  font-size: 36rpx;
  color: #5D4037;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 32rpx;
  color: #8B5A2B;
  margin-bottom: 16rpx;
}

/* 通用按钮样式 */
.btn {
  background-color: #D4B08C;
  color: #fff;
  border-radius: 10rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  border: 2rpx solid #8B5A2B;
  text-align: center;
}

.btn-primary {
  background-color: #8B5A2B;
}

.btn-outline {
  background-color: transparent;
  color: #8B5A2B;
}

/* 通用卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 分割线 */
.divider {
  height: 2rpx;
  background-color: rgba(139, 90, 43, 0.2);
  margin: 20rpx 0;
}

/* 图片基础样式 */
.img-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 页面通用内边距 */
.page-padding {
  padding: 30rpx;
}

/* 页面内容区域 */
.scrollarea {
  flex: 1;
  overflow-y: auto;
} 
